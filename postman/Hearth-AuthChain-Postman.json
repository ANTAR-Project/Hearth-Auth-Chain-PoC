            "description": "Deliberately malformed/expired JWT. Gateway should reject before reaching NAS."
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('gateway rejects bad token (401)', () => pm.expect(pm.response.code).to.eql(401));"
          ], "type": "text/javascript" }}]
        },
        {
          "name": "12.2 Valid token, wrong HTTP method ❌",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/auth/login",
            "header": [{ "key": "Authorization", "value": "Bearer {{resident_token}}" }],
            "description": "Login route only accepts POST — gateway predicate should block DELETE."
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('gateway returns 404/405', () => pm.expect(pm.response.code).to.be.oneOf([404,405]));"
          ], "type": "text/javascript" }}]
        },
        {
          "name": "12.3 Resident cannot access another user's workspace ❌",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/nas/files/list?username={{guest_username}}",
              "query": [{ "key": "username", "value": "{{guest_username}}" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{resident_token}}" }],
            "description": "resourceId is bound to the JWT subject (OWN scope), so the downstream service should block cross-user access."
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('cross-user access denied (403 or 404)', () => pm.expect(pm.response.code).to.be.oneOf([403,404]));"
