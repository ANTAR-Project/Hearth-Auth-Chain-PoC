    {
      "name": "11 · Service Token (OAuth client_credentials)",
      "description": "Direct call to auth-service (bypasses gateway — for internal/svc-to-svc testing). These call auth-service directly on port 9000 IF it's exposed, otherwise this tests the gateway's passthrough.",
      "item": [
        {
          "name": "11.1 Client credentials – JSON ✅",
          "request": {
            "method": "POST",
            "url": "http://localhost:9000/oauth/token",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"client_credentials\",\n  \"clientId\": \"video-service\",\n  \"clientSecret\": \"REPLACE_WITH_VIDEO_SVC_SECRET\",\n  \"audience\": \"nas-orchestrator\",\n  \"scope\": \"nas:read:raw/**\"\n}"
            },
            "description": "Direct auth-service call. Only works if port 9000 is published. Use for local dev."
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has accessToken', () => pm.expect(pm.response.json()).to.have.property('accessToken'));"
          ], "type": "text/javascript" }}]
        },
        {
          "name": "11.2 Client credentials – form-urlencoded ✅",
          "request": {
            "method": "POST",
            "url": "http://localhost:9000/oauth/token",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type",    "value": "client_credentials" },
                { "key": "client_id",     "value": "video-service" },
                { "key": "client_secret", "value": "REPLACE_WITH_VIDEO_SVC_SECRET" },
                { "key": "audience",      "value": "nas-orchestrator" },
                { "key": "scope",         "value": "nas:read:raw/**" }
              ]
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
