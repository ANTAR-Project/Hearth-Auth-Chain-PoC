          "name": "11.3 Wrong secret ❌",
          "request": {
            "method": "POST",
            "url": "http://localhost:9000/oauth/token",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"client_credentials\",\n  \"clientId\": \"video-service\",\n  \"clientSecret\": \"wrong-secret\",\n  \"audience\": \"nas-orchestrator\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 401', () => pm.response.to.have.status(401));"
          ], "type": "text/javascript" }}]
        },
        {
          "name": "11.4 Out-of-scope request ❌",
          "request": {
            "method": "POST",
            "url": "http://localhost:9000/oauth/token",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"client_credentials\",\n  \"clientId\": \"video-service\",\n  \"clientSecret\": \"REPLACE_WITH_VIDEO_SVC_SECRET\",\n  \"audience\": \"nas-orchestrator\",\n  \"scope\": \"admin:all\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
