              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"ON\"\n}"
            },
            "description": "Policy: element.camera.guest.deny — DENY STREAM on ELEMENT/CAMERA. CONTROL should also be blocked for GUEST."
          },
