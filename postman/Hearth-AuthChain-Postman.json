        },
        {
          "name": "9.2 List playlists (RESIDENT) ✅",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/stream/playlists",
            "header": [{ "key": "Authorization", "value": "Bearer {{resident_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 2xx or 404', () => pm.expect(pm.response.code).to.be.oneOf([200,404]));"
          ], "type": "text/javascript" }}]
        },
        {
          "name": "9.3 HLS playlist (public – requires ?token=) ✅",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/nas/stream/playlist?token=REPLACE_WITH_STREAM_TOKEN&path=some/video.m3u8",
              "query": [
                { "key": "token", "value": "REPLACE_WITH_STREAM_TOKEN" },
                { "key": "path",  "value": "some/video.m3u8" }
              ]
            },
            "description": "Public route — gateway passes through, nas-orchestrator validates ?token= internally. No Authorization header needed."
          },
          "event": [{ "listen": "test", "script": { "exec": [
